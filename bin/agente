#!/bin/bash

# ─────────────────────────────────────────────────────────────────────────────
#  AG Suite Agent Framework — CLI
# ─────────────────────────────────────────────────────────────────────────────

# La versión vive en el archivo VERSION del framework, no clavada aquí, para que
# 'agente doctor' pueda comparar la del framework contra la de la instancia.
_leer_version_framework() {
    cat "$RUTA_FRAMEWORK/VERSION" 2>/dev/null || echo "desconocida"
}

_resolver_ruta_framework() {
    local origen="$0"
    while [ -L "$origen" ]; do
        local dir="$(dirname "$origen")"
        origen="$(readlink "$origen")"
        [[ "$origen" != /* ]] && origen="$dir/$origen"
    done
    echo "$(cd "$(dirname "$origen")/.." && pwd)"
}
RUTA_FRAMEWORK="$(_resolver_ruta_framework)"
VERSION="$(_leer_version_framework)"

_encontrar_raiz() {
    local dir="$PWD"
    while [ "$dir" != "/" ]; do
        # .git es directorio en un clon normal y archivo en worktrees/submódulos
        if [ -e "$dir/.git" ] || [ -f "$dir/docs/.agents/agent-config.md" ]; then
            echo "$dir"; return 0
        fi
        dir="$(dirname "$dir")"
    done
    echo "$PWD"
}

RUTA_PROYECTO="$(_encontrar_raiz)"
RUTA_AGENTS="$RUTA_PROYECTO/docs/.agents"
RUTA_SCRIPTS="$RUTA_PROYECTO/scripts"

VERDE="\033[0;32m"
AMARILLO="\033[0;33m"
ROJO="\033[0;31m"
AZUL="\033[0;34m"
CYAN="\033[0;36m"
MAGENTA="\033[0;35m"
GRIS="\033[0;90m"
NEGRITA="\033[1m"
RESET="\033[0m"

ok()        { echo -e "  ${VERDE}✅${RESET} $1"; }
warn()      { echo -e "  ${AMARILLO}⚠️ ${RESET} $1"; }
error()     { echo -e "  ${ROJO}❌${RESET} $1"; }
info()      { echo -e "  ${AZUL}›${RESET}  $1"; }
skip()      { echo -e "  ${GRIS}⏭️  $1${RESET}"; }
separador() { echo -e "${GRIS}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"; }
linea_fina(){ echo -e "${GRIS}────────────────────────────────────────────────${RESET}"; }

# Confirmación robusta. Lee de la terminal cuando la hay (para que funcione aun
# si el script llegó por una tubería) y de stdin cuando no, para que se pueda
# automatizar con 'echo s | agente ...'. Sin ninguna de las dos, no asume un sí.
# El prompt se imprime con printf y NO con 'read -p': read -p lo escribe en
# stderr, y al silenciar stderr la pregunta desaparecía dejando el proceso
# aparentemente colgado, esperando una entrada invisible.
_confirmar() {
    local prompt="$1" respuesta=""
    printf "%s" "$prompt"
    # Se intenta la terminal primero y se cae a stdin si no hay una usable, para
    # que funcione interactivo y automatizado. El 2>/dev/null va ANTES de
    # < /dev/tty: si va después, el error de una terminal ausente ya se imprimió.
    if [ -e /dev/tty ] && read respuesta 2>/dev/null < /dev/tty; then
        :
    else
        read respuesta 2>/dev/null || respuesta=""
    fi
    echo ""
    [[ "$respuesta" == "s" || "$respuesta" == "S" ]]
}

tiene_claude() { command -v claude &>/dev/null; }
tiene_iterm()  { osascript -e 'tell application "iTerm2" to version' &>/dev/null 2>&1; }

leer_config() {
    grep "^$1=" "$RUTA_AGENTS/agent-config.md" 2>/dev/null | cut -d= -f2 | tr -d '"' | xargs
}
leer_status() {
    grep "^$1=" "$RUTA_AGENTS/status.md" 2>/dev/null | cut -d= -f2 | tr -d '"' | xargs
}
nombre_proyecto() { local n="$(leer_config nombre)"; echo "${n:-Proyecto}"; }

# Rama destino del PR. Nunca se clava 'main': primero la config del proyecto,
# luego la rama por defecto del remoto, y solo al final 'main' como último recurso
# (instancias con config vieja, que actualizar.sh preserva sin la clave nueva).
rama_destino() {
    local rama
    rama="$(leer_config branch_target)"
    if [ -z "$rama" ]; then
        rama="$(git -C "$RUTA_PROYECTO" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)"
        rama="${rama#origin/}"
    fi
    echo "${rama:-main}"
}

notificar() {
    osascript -e "display notification \"$2\" with title \"$1\" sound name \"${3:-Glass}\"" 2>/dev/null || true
}

spinner() {
    local pid=$1 msg="$2"
    local frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
    local i=0
    while kill -0 "$pid" 2>/dev/null; do
        printf "\r  ${AZUL}${frames[$((i % 10))]}${RESET} $msg"
        sleep 0.1
        i=$((i + 1))
    done
    printf "\r%-60s\r" " "
}

icono_estado() {
    case "$1" in
        idle)           printf "${GRIS}⏸  idle${RESET}" ;;
        ready)          printf "${AMARILLO}🟡 ready ← tiene trabajo${RESET}" ;;
        in_progress)    printf "${CYAN}🔄 en progreso${RESET}" ;;
        "done"*)        printf "${VERDE}✅ done${RESET}" ;;
        needs_fix)      printf "${ROJO}🔴 needs_fix${RESET}" ;;
        blocked)        printf "${ROJO}⛔ bloqueado${RESET}" ;;
        awaiting_human) printf "${MAGENTA}👀 esperando revisión${RESET}" ;;
        pr_ready)       printf "${MAGENTA}📦 esperando autorización de PR${RESET}" ;;
        reviewing)      printf "${CYAN}🔍 revisando${RESET}" ;;
        coordinating)   printf "${AZUL}🧠 coordinando${RESET}" ;;
        *)              printf "${GRIS}${1:- — }${RESET}" ;;
    esac
}

# ─── Construir contenido del dashboard en una variable ───────────────────────
# Evita cualquier render parcial — todo se construye primero, luego se imprime
_construir_dashboard() {
    local auto="$1"
    local out=""

    local NOMBRE ADR TITULO BRANCH INICIADO
    local ORCH BE FE QA CTX FDOCS
    local BLOCKER_AG BLOCKER_DET HANDOFF_MSG APROBACION
    local BE_ISSUES FE_ISSUES COMPLETADOS

    NOMBRE="$(nombre_proyecto)"
    ADR="$(leer_status adr)"
    TITULO="$(leer_status titulo)"
    BRANCH="$(leer_status branch)"
    INICIADO="$(leer_status iniciado)"
    ORCH="$(leer_status orchestrator)"
    BE="$(leer_status backend)"
    FE="$(leer_status frontend)"
    QA="$(leer_status qa)"
    CTX="$(leer_status contexto)"
    FDOCS="$(leer_status featuredocs)"
    BLOCKER_AG="$(leer_status blocker_agente)"
    BLOCKER_DET="$(leer_status blocker_detalle)"
    HANDOFF_MSG="$(leer_status handoff_message)"
    APROBACION="$(leer_status aprobacion)"
    BE_ISSUES="$(leer_status backend_issues)"
    FE_ISSUES="$(leer_status frontend_issues)"
    COMPLETADOS="$(leer_status completados)"

    # Construir en buffer
    out+="\n"
    out+="${GRIS}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}\n"
    out+="  ${NEGRITA}${AZUL}$NOMBRE${RESET} — Dashboard  ${GRIS}$(date '+%H:%M:%S')${RESET}\n"
    out+="${GRIS}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}\n"
    out+="\n"

    if [ -n "$ADR" ]; then
        out+="  ${NEGRITA}$ADR${RESET} — $TITULO\n"
        [ -n "$BRANCH" ] && out+="  ${GRIS}$BRANCH${RESET}\n"

        if [ -n "$INICIADO" ]; then
            local ahora inicio diff
            ahora=$(date +%s)
            inicio=$(date -j -f "%Y-%m-%d" "$INICIADO" +%s 2>/dev/null || date -d "$INICIADO" +%s 2>/dev/null || echo "")
            if [ -n "$inicio" ] && [ "$inicio" -gt 0 ]; then
                diff=$(( (ahora - inicio) / 3600 ))
                out+="  ${GRIS}Iniciado hace ${diff}h${RESET}\n"
            fi
        fi

        local TOTAL_BE=0 TOTAL_FE=0 DONE=0 TOTAL=0 PORC=0
        [ -n "$BE_ISSUES"   ] && TOTAL_BE=$(echo "$BE_ISSUES"   | tr ',' '\n' | grep -c '\S' 2>/dev/null || echo 0)
        [ -n "$FE_ISSUES"   ] && TOTAL_FE=$(echo "$FE_ISSUES"   | tr ',' '\n' | grep -c '\S' 2>/dev/null || echo 0)
        TOTAL=$((TOTAL_BE + TOTAL_FE))
        [ -n "$COMPLETADOS" ] && DONE=$(echo "$COMPLETADOS" | tr ',' '\n' | grep -c '\S' 2>/dev/null || echo 0)
        [ "$TOTAL" -gt 0 ]    && PORC=$((DONE * 100 / TOTAL))

        if [ "$TOTAL" -gt 0 ]; then
            local BLOQUES=$((PORC / 5)) BARRA=""
            for ((i=0; i<20; i++)); do
                [ $i -lt $BLOQUES ] && BARRA="${BARRA}█" || BARRA="${BARRA}░"
            done
            out+="\n"
            out+="  ${VERDE}$BARRA${RESET} ${NEGRITA}$DONE/$TOTAL${RESET} issues ${GRIS}($PORC%)${RESET}\n"
        fi
    else
        out+="  ${GRIS}Sin ADR activo — usa 'Nueva feature' para empezar${RESET}\n"
    fi

    out+="\n"
    out+="${GRIS}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}\n"
    out+="\n"
    out+="  ${NEGRITA}Agentes${RESET}\n"
    out+="\n"
    out+="$(printf "  🧠 %-14s " "Orquestador")$(icono_estado "$ORCH")\n"
    out+="$(printf "  ⚙️  %-14s " "Backend")$(icono_estado "$BE")\n"
    out+="$(printf "  🎨 %-14s " "Frontend")$(icono_estado "$FE")\n"
    out+="$(printf "  🔍 %-14s " "QA")$(icono_estado "$QA")\n"
    out+="$(printf "  📋 %-14s " "Contexto")$(icono_estado "$CTX")\n"
    out+="$(printf "  📚 %-14s " "Documentador")$(icono_estado "$FDOCS")\n"
    out+="\n"

    if [ -e "$RUTA_PROYECTO/.git" ]; then
        local ARCHIVOS COMMITS
        local DESTINO
        DESTINO="$(rama_destino)"
        ARCHIVOS=$(git -C "$RUTA_PROYECTO" diff --name-only HEAD 2>/dev/null | wc -l | tr -d ' ')
        COMMITS=$(git -C "$RUTA_PROYECTO" rev-list --count "$DESTINO..HEAD" 2>/dev/null || echo "—")
        out+="${GRIS}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}\n"
        out+="\n"
        out+="  ${NEGRITA}Git${RESET}\n"
        out+="\n"
        out+="$(printf "  %-26s ${NEGRITA}%s${RESET}\n" "Archivos modificados:" "$ARCHIVOS")"
        out+="$(printf "  %-26s ${NEGRITA}%s${RESET} ${GRIS}(vs %s)${RESET}\n" "Commits adelante:" "$COMMITS" "$DESTINO")"
        out+="\n"
    fi

    if [ -n "$BLOCKER_AG" ]; then
        out+="${GRIS}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}\n"
        out+="\n"
        out+="  ${ROJO}${NEGRITA}🚨 BLOCKER — $BLOCKER_AG${RESET}\n"
        out+="  ${ROJO}$BLOCKER_DET${RESET}\n"
        out+="\n"
    fi

    if [ -n "$HANDOFF_MSG" ]; then
        out+="${GRIS}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}\n"
        out+="\n"
        out+="  ${NEGRITA}Handoff${RESET}\n"
        out+="  ${GRIS}$HANDOFF_MSG${RESET}\n"
        out+="\n"
    fi

    if [ "$ORCH" = "awaiting_human" ] && [ "$APROBACION" = "pending" ]; then
        out+="${GRIS}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}\n"
        out+="\n"
        out+="  ${MAGENTA}${NEGRITA}👀 LISTO PARA TU REVISIÓN${RESET}\n"
        out+="  ${MAGENTA}Prueba el feature y revisa los commits de la branch${RESET}\n"
        out+="\n"
    fi

    if [ "$ORCH" = "pr_ready" ]; then
        out+="${GRIS}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}\n"
        out+="\n"
        out+="  ${MAGENTA}${NEGRITA}📦 ESPERANDO TU AUTORIZACIÓN PARA EL PR${RESET}\n"
        out+="  ${MAGENTA}Código y documentación commiteados. El merge lo haces tú.${RESET}\n"
        out+="\n"
    elif [ "$APROBACION" = "approved" ]; then
        out+="${GRIS}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}\n"
        out+="\n"
        out+="  ${VERDE}${NEGRITA}✅ APROBADO — documentando antes del PR${RESET}\n"
        out+="\n"
    fi

    # El dashboard solo OBSERVA: lee status.md y notifica. Nunca activó agentes
    # y no debe hacerlo — quien coordina y activa es el Orquestador.
    local refresh_estado
    $auto && refresh_estado="${VERDE}ON${RESET}" || refresh_estado="${GRIS}OFF${RESET}"
    out+="${GRIS}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}\n"
    out+="\n"
    out+="  Modo: ${GRIS}multi-terminal${RESET}  ${VERDE}(Claude Code)${RESET}\n"
    out+="  Auto-refresh: $refresh_estado  ${GRIS}(cada ${INTERVALO}s — solo observa y notifica)${RESET}\n"
    out+="\n"
    out+="  ${GRIS}[a] toggle auto-refresh  [r] refresh  [q] salir${RESET}\n"
    out+="\n"

    # Imprimir todo de una sola vez al final
    printf "%b" "$out"
}

# ─── Dashboard live ───────────────────────────────────────────────────────────
INTERVALO=10

cmd_dashboard() {
    local NOMBRE="$(nombre_proyecto)"

    # Si ya estamos en modo dashboard interno (llamado desde la terminal dedicada)
    if [ "$_DASHBOARD_INTERNO" = "1" ]; then
        _dashboard_loop
        return
    fi

    # Abrir terminal dedicada para el dashboard
    info "Abriendo dashboard en terminal dedicada..."
    echo ""

    local CMD="export _DASHBOARD_INTERNO=1; $0 dashboard"

    if tiene_iterm; then
        osascript <<EOF
tell application "iTerm2"
    activate
    set w to (create window with default profile)
    tell w
        tell current session
            set name to "$NOMBRE | 📊 Dashboard"
            write text "cd '$RUTA_PROYECTO' && $CMD"
        end tell
    end tell
end tell
EOF
    else
        osascript <<EOF
tell application "Terminal"
    activate
    set t to do script "cd '$RUTA_PROYECTO' && $CMD"
    set custom title of t to "$NOMBRE | 📊 Dashboard"
end tell
EOF
    fi

    ok "Dashboard abierto en terminal dedicada."
    echo ""
}

# Loop interno del dashboard — solo se ejecuta en la terminal dedicada
# Observabilidad pura del pipeline: refresca la vista de status.md y notifica los
# cambios de estado. NO activa agentes — de eso se encarga el Orquestador.
_dashboard_loop() {
    local AUTO_POLL=true
    local ULTIMO_BE="" ULTIMO_FE="" ULTIMO_ORCH=""

    _salir() {
        printf '\033c'
        echo ""
        echo -e "  ${GRIS}Dashboard cerrado.${RESET}"
        echo ""
        exit 0
    }
    trap '_salir' INT TERM

    printf '\033c'

    while true; do
        local CONTENIDO
        CONTENIDO="$(_construir_dashboard "$AUTO_POLL")"

        printf '\033c'
        echo -e "$CONTENIDO"

        local tecla=""
        IFS= read -r -s -n1 -t "$INTERVALO" tecla 2>/dev/null || true

        case "$tecla" in
            a|A) $AUTO_POLL && AUTO_POLL=false || AUTO_POLL=true ;;
            r|R) : ;;
            q|Q) _salir ;;
        esac

        if $AUTO_POLL; then
            local BE FE ORCH NOMBRE ADR
            BE="$(leer_status backend)"
            FE="$(leer_status frontend)"
            ORCH="$(leer_status orchestrator)"
            NOMBRE="$(nombre_proyecto)"
            ADR="$(leer_status adr)"

            [ "$BE"   = "done"           ] && [ "$ULTIMO_BE"   != "done"           ] && notificar "$NOMBRE" "⚙️ Backend completó" "Glass"
            [ "$FE"   = "done"           ] && [ "$ULTIMO_FE"   != "done"           ] && notificar "$NOMBRE" "🎨 Frontend completó" "Glass"
            [ "$ORCH" = "awaiting_human" ] && [ "$ULTIMO_ORCH" != "awaiting_human" ] && notificar "$NOMBRE" "👀 $ADR listo para revisión" "Ping"
            [ "$ORCH" = "pr_ready"       ] && [ "$ULTIMO_ORCH" != "pr_ready"       ] && notificar "$NOMBRE" "📦 $ADR espera tu autorización para el PR" "Ping"
            [ "$BE"   = "needs_fix"      ] && [ "$ULTIMO_BE"   != "needs_fix"      ] && notificar "$NOMBRE" "🔴 Backend necesita correcciones" "Basso"
            [ "$FE"   = "needs_fix"      ] && [ "$ULTIMO_FE"   != "needs_fix"      ] && notificar "$NOMBRE" "🔴 Frontend necesita correcciones" "Basso"

            ULTIMO_BE="$BE"
            ULTIMO_FE="$FE"
            ULTIMO_ORCH="$ORCH"
        fi
    done
}

# ─── Launcher ────────────────────────────────────────────────────────────────
cmd_start() {
    local NOMBRE="$(nombre_proyecto)"
    local ADR="$(leer_status adr)"
    local TITULO="$(leer_status titulo)"

    printf '\033[2J\033[H'
    echo ""
    separador
    echo -e "  ${NEGRITA}${AZUL}AG Suite Agent Framework${RESET}  ${GRIS}v$VERSION${RESET}"
    echo -e "  ${NEGRITA}$NOMBRE${RESET}"
    separador
    echo ""

    if [ -n "$ADR" ]; then
        echo -e "  ${NEGRITA}ADR en curso:${RESET} ${AZUL}$ADR${RESET} — $TITULO"
        echo ""
        printf "  🧠 %-14s " "Orquestador";  icono_estado "$(leer_status orchestrator)"; echo ""
        printf "  ⚙️  %-14s " "Backend";      icono_estado "$(leer_status backend)";      echo ""
        printf "  🎨 %-14s " "Frontend";     icono_estado "$(leer_status frontend)";     echo ""
        printf "  📋 %-14s " "Contexto";     icono_estado "$(leer_status contexto)";     echo ""
        printf "  📚 %-14s " "Documentador"; icono_estado "$(leer_status featuredocs)";  echo ""
        echo ""
        linea_fina
        echo ""
    fi

    echo -e "  ${NEGRITA}¿Qué quieres hacer?${RESET}"
    echo ""
    echo -e "  ${VERDE}[1]${RESET} Pipeline completo     → abre todas las terminales"
    echo -e "  ${VERDE}[2]${RESET} Abrir agente          → elige cuál"
    echo -e "  ${VERDE}[3]${RESET} Dashboard live        → monitoreo en tiempo real"
    echo -e "  ${VERDE}[4]${RESET} Nueva feature         → Orquestador para brainstorming"
    [ -n "$ADR" ] && echo -e "  ${VERDE}[5]${RESET} Continuar ADR         → abre solo lo que falta"
    echo -e "  ${VERDE}[6]${RESET} Estado del pipeline   → resumen rápido"
    echo -e "  ${GRIS}[q]${RESET} Salir"
    echo ""
    separador
    echo ""
    read -p "  Opción: " OPCION
    echo ""

    case "$OPCION" in
        1) _launcher_pipeline_completo ;;
        2) _launcher_agente_individual ;;
        3) cmd_dashboard ;;
        4) _launcher_nueva_feature ;;
        5) [ -n "$ADR" ] && _launcher_continuar_adr || _launcher_nueva_feature ;;
        6) cmd_status ;;
        q|Q) echo -e "  ${GRIS}Hasta luego.${RESET}"; echo ""; exit 0 ;;
        *) warn "Opción no válida."; sleep 1; cmd_start ;;
    esac
}

_verificar_proyecto() {
    if [ ! -f "$RUTA_AGENTS/agent-config.md" ]; then
        echo ""
        error "No se detectó un proyecto con AG Suite Agent Framework."
        info "Navega a la raíz de tu proyecto e inicializa con: agente init"
        echo ""
        exit 1
    fi
}

_launcher_pipeline_completo() {
    _verificar_proyecto
    echo -e "  ${NEGRITA}Pipeline completo — $(nombre_proyecto)${RESET}"
    echo ""
    if tiene_iterm; then
        info "Abriendo iTerm2 con paneles..."
        osascript "$RUTA_SCRIPTS/lanzar-agentes-iterm.applescript"
    else
        info "Abriendo Terminal.app..."
        bash "$RUTA_SCRIPTS/lanzar-agentes-terminal.sh"
    fi
    ok "Terminales abiertas"
    echo ""
    read -p "  ¿Abrir dashboard ahora? (S/n): " VER_DASH
    [[ "$VER_DASH" != "n" && "$VER_DASH" != "N" ]] && cmd_dashboard
}

_launcher_start_iterm() {
    _verificar_proyecto
    echo ""
    echo -e "  ${NEGRITA}$(nombre_proyecto) — iTerm2${RESET}"
    echo ""

    if ! tiene_iterm; then
        warn "iTerm2 no está instalado."
        read -p "  ¿Iniciamos en Terminal.app? (S/n): " FALLBACK
        if [[ "$FALLBACK" != "n" && "$FALLBACK" != "N" ]]; then
            _launcher_start_terminal
        else
            echo -e "  ${GRIS}Cancelado.${RESET}"
            echo ""
        fi
        return
    fi

    info "Abriendo todos los agentes en iTerm2 con paneles..."
    osascript "$RUTA_SCRIPTS/lanzar-agentes-iterm.applescript"
    ok "6 agentes abiertos en iTerm2"
    echo ""
    read -p "  ¿Abrir dashboard ahora? (S/n): " VER_DASH
    [[ "$VER_DASH" != "n" && "$VER_DASH" != "N" ]] && cmd_dashboard
}

_launcher_start_terminal() {
    _verificar_proyecto
    echo ""
    echo -e "  ${NEGRITA}$(nombre_proyecto) — Terminal.app${RESET}"
    echo ""
    info "Abriendo todos los agentes en Terminal.app..."
    bash "$RUTA_SCRIPTS/lanzar-agentes-terminal.sh"
    ok "6 agentes abiertos en Terminal.app"
    echo ""
    read -p "  ¿Abrir dashboard ahora? (S/n): " VER_DASH
    [[ "$VER_DASH" != "n" && "$VER_DASH" != "N" ]] && cmd_dashboard
}

_launcher_agente_individual() {
    printf '\033[2J\033[H'
    echo ""
    separador
    echo -e "  ${NEGRITA}Abrir agente individual${RESET}"
    separador
    echo ""
    echo -e "  ${VERDE}[1]${RESET} 🧠 Orquestador"
    echo -e "  ${VERDE}[2]${RESET} ⚙️  Backend"
    echo -e "  ${VERDE}[3]${RESET} 🎨 Frontend"
    echo -e "  ${VERDE}[4]${RESET} 🔍 QA"
    echo -e "  ${VERDE}[5]${RESET} 📋 Contexto"
    echo -e "  ${VERDE}[6]${RESET} 📚 Documentador"
    echo -e "  ${GRIS}[b]${RESET} ← Volver"
    echo ""
    read -p "  Agente: " AG
    case "$AG" in
        1) bash "$RUTA_SCRIPTS/iniciar-agente.sh" orquestador ;;
        2) bash "$RUTA_SCRIPTS/iniciar-agente.sh" backend ;;
        3) bash "$RUTA_SCRIPTS/iniciar-agente.sh" frontend ;;
        4) bash "$RUTA_SCRIPTS/iniciar-agente.sh" qa ;;
        5) bash "$RUTA_SCRIPTS/iniciar-agente.sh" contexto ;;
        6) bash "$RUTA_SCRIPTS/iniciar-agente.sh" documentador ;;
        b|B) cmd_start ;;
        *) warn "Opción no válida."; sleep 1; _launcher_agente_individual ;;
    esac
}

_launcher_nueva_feature() {
    echo -e "  ${NEGRITA}Nueva feature — Orquestador${RESET}"
    echo ""
    info "Abriendo Orquestador para planear..."
    echo ""
    bash "$RUTA_SCRIPTS/iniciar-agente.sh" orquestador
}

_launcher_continuar_adr() {
    local BE="$(leer_status backend)"
    local FE="$(leer_status frontend)"
    local QA="$(leer_status qa)"
    local CTX="$(leer_status contexto)"
    local FDOCS="$(leer_status featuredocs)"
    local ORCH="$(leer_status orchestrator)"
    local abiertos=0

    echo -e "  ${NEGRITA}Continuar $(leer_status adr)${RESET}"
    echo ""

    for agente in orquestador backend frontend qa contexto documentador; do
        local estado
        case "$agente" in
            orquestador)  estado="$ORCH" ;;
            backend)      estado="$BE" ;;
            frontend)     estado="$FE" ;;
            qa)           estado="$QA" ;;
            contexto)     estado="$CTX" ;;
            documentador) estado="$FDOCS" ;;
        esac
        if [[ "$estado" != "done"* ]]; then
            bash "$RUTA_SCRIPTS/iniciar-agente.sh" "$agente" &
            sleep 0.5
            ok "$agente ($estado)"
            abiertos=$((abiertos + 1))
        else
            skip "$agente — done"
        fi
    done

    echo ""
    [ "$abiertos" -eq 0 ] && ok "Todos done." || info "$abiertos agente(s) abiertos."
    echo ""
    read -p "  ¿Abrir dashboard? (S/n): " VER_DASH
    [[ "$VER_DASH" != "n" && "$VER_DASH" != "N" ]] && cmd_dashboard
}

# ─── Status rápido ────────────────────────────────────────────────────────────
cmd_status() {
    echo ""
    separador
    echo -e "  ${NEGRITA}$(nombre_proyecto) — Estado${RESET}"
    separador
    echo ""

    local ADR="$(leer_status adr)"
    if [ -n "$ADR" ]; then
        echo -e "  ${AZUL}${NEGRITA}$ADR${RESET} — $(leer_status titulo)"
        echo ""
    else
        echo -e "  ${GRIS}Sin ADR activo${RESET}"; echo ""
    fi

    printf "  🧠 %-14s " "Orquestador";  icono_estado "$(leer_status orchestrator)"; echo ""
    printf "  ⚙️  %-14s " "Backend";      icono_estado "$(leer_status backend)";      echo ""
    printf "  🎨 %-14s " "Frontend";     icono_estado "$(leer_status frontend)";     echo ""
    printf "  🔍 %-14s " "QA";           icono_estado "$(leer_status qa)";           echo ""
    printf "  📋 %-14s " "Contexto";     icono_estado "$(leer_status contexto)";     echo ""
    printf "  📚 %-14s " "Documentador"; icono_estado "$(leer_status featuredocs)";  echo ""

    local BLOCKER_AG="$(leer_status blocker_agente)"
    local APROBACION="$(leer_status aprobacion)"
    [ -n "$BLOCKER_AG" ]           && echo -e "\n  ${ROJO}🚨 Blocker: $BLOCKER_AG${RESET}"
    [ "$APROBACION" = "approved" ] && echo -e "\n  ${VERDE}✅ Aprobado para commit${RESET}"

    echo ""
    separador
    echo ""
}

# ─── Init ─────────────────────────────────────────────────────────────────────
cmd_init() {
    local MODO_CONFIG="crear"

    echo ""
    separador
    echo -e "  ${NEGRITA}AG Suite Agent Framework — Init${RESET}"
    separador
    echo ""
    info "Proyecto:  $RUTA_PROYECTO"
    info "Framework: $RUTA_FRAMEWORK"
    echo ""

    if [ ! -d "$RUTA_FRAMEWORK/template" ]; then
        error "Template no encontrado en: $RUTA_FRAMEWORK/template"
        exit 1
    fi

    if [ ! -d "$RUTA_PROYECTO/.git" ]; then
        warn "No se detectó repositorio git."
        read -p "  ¿Continuar? (s/N): " C
        [[ "$C" != "s" && "$C" != "S" ]] && { echo "  Cancelado."; exit 0; }
        echo ""
    fi

    if [ -f "$RUTA_AGENTS/agent-config.md" ]; then
        echo -e "  ${AMARILLO}agent-config.md ya existe.${RESET}"
        echo ""
        echo "  [1] Solo llenar campos vacíos (recomendado)"
        echo "  [2] Sobreescribir completo"
        echo "  [3] Cancelar"
        echo ""
        read -p "  Opción: " OPC
        case "$OPC" in
            1) MODO_CONFIG="actualizar" ;;
            2) MODO_CONFIG="sobreescribir" ;;
            *) echo "  Cancelado."; exit 0 ;;
        esac
        echo ""
    fi

    echo -e "  ${NEGRITA}Estructura:${RESET}"
    echo ""
    _cc() { [ -d "$RUTA_PROYECTO/$1" ] && skip "$1/" || { mkdir -p "$RUTA_PROYECTO/$1"; ok "$1/"; }; }
    _ca() { [ -f "$RUTA_PROYECTO/$1" ] && skip "$1"  || { printf '%s\n' "$2" > "$RUTA_PROYECTO/$1"; ok "$1"; }; }

    _cc "docs/.agents/prompts"
    _cc "docs/.agents/prompts/proyecto"
    _cc "docs/adr"
    _cc "docs/issues"
    _cc "docs/contracts/models"
    _cc "docs/features"
    _cc "scripts"

    echo ""
    echo -e "  ${NEGRITA}Archivos base:${RESET}"
    echo ""
    _ca "docs/adr/README.md"      "# ADRs

| ADR | Título | Estado |
|-----|--------|--------|
"
    _ca "docs/contracts/README.md" "# Contracts
"
    _ca "docs/PROJECT_CONTEXT.md"  "# Contexto del Proyecto
"

    echo ""
    echo -e "  ${NEGRITA}Framework:${RESET}"
    echo ""

    _cp() {
        [ ! -f "$1" ] && { warn "No encontrado: $(basename "$1")"; return; }
        [ -f "$2" ] && skip "$(basename "$2")" || { cp "$1" "$2"; ok "$(basename "$2")"; }
    }

    local SRC="$RUTA_FRAMEWORK/template"
    _cp "$SRC/docs/.agents/prompts/orchestrator.md" "$RUTA_AGENTS/prompts/orchestrator.md"
    _cp "$SRC/docs/.agents/prompts/backend.md"      "$RUTA_AGENTS/prompts/backend.md"
    _cp "$SRC/docs/.agents/prompts/frontend.md"     "$RUTA_AGENTS/prompts/frontend.md"
    _cp "$SRC/docs/.agents/prompts/qa.md"           "$RUTA_AGENTS/prompts/qa.md"
    _cp "$SRC/docs/.agents/prompts/context.md"      "$RUTA_AGENTS/prompts/context.md"
    _cp "$SRC/docs/.agents/prompts/featuredocs.md"  "$RUTA_AGENTS/prompts/featuredocs.md"
    _cp "$SRC/docs/.agents/prompts/api-architect.md"         "$RUTA_AGENTS/prompts/api-architect.md"
    _cp "$SRC/docs/.agents/prompts/api-contract-reviewer.md" "$RUTA_AGENTS/prompts/api-contract-reviewer.md"
    _cp "$SRC/docs/.agents/prompts/proyecto/README.md" "$RUTA_AGENTS/prompts/proyecto/README.md"
    _cp "$SRC/docs/.agents/agentes.md"              "$RUTA_AGENTS/agentes.md"
    _cp "$SRC/docs/.agents/arranque-terminal.md"    "$RUTA_AGENTS/arranque-terminal.md"
    _cp "$SRC/docs/.agents/arranque-sesion.md"      "$RUTA_AGENTS/arranque-sesion.md"
    _cp "$SRC/docs/.agents/agente-inicializador.md" "$RUTA_AGENTS/agente-inicializador.md"
    _cp "$SRC/docs/.agents/status.md"               "$RUTA_AGENTS/status.md"

    if [ "$MODO_CONFIG" = "crear" ] || [ "$MODO_CONFIG" = "sobreescribir" ]; then
        cp "$SRC/docs/.agents/agent-config.TEMPLATE.md" "$RUTA_AGENTS/agent-config.md"
        ok "agent-config.md"
    fi

    # Punteros de arranque. _cp no pisa lo que ya existe: si el proyecto ya tiene
    # un CLAUDE.md propio, se respeta y se avisa (ver 'agente doctor').
    _cp "$SRC/CLAUDE.md"                                "$RUTA_PROYECTO/CLAUDE.md"
    _cp "$SRC/AGENTS.md"                                "$RUTA_PROYECTO/AGENTS.md"

    _cp "$SRC/scripts/iniciar-agente.sh"                "$RUTA_PROYECTO/scripts/iniciar-agente.sh"
    _cp "$SRC/scripts/lanzar-agentes-iterm.applescript" "$RUTA_PROYECTO/scripts/lanzar-agentes-iterm.applescript"
    _cp "$SRC/scripts/lanzar-agentes-terminal.sh"       "$RUTA_PROYECTO/scripts/lanzar-agentes-terminal.sh"
    _cp "$SRC/scripts/ci-checks.sh"                     "$RUTA_PROYECTO/scripts/ci-checks.sh"
    _cp "$SRC/Makefile"                                 "$RUTA_PROYECTO/Makefile"
    chmod +x "$RUTA_PROYECTO/scripts/iniciar-agente.sh" "$RUTA_PROYECTO/scripts/lanzar-agentes-terminal.sh" \
             "$RUTA_PROYECTO/scripts/ci-checks.sh" 2>/dev/null

    # Plantilla de workflow de CI. Solo se instala si el proyecto ya usa GitHub
    # Actions o si activa el perfil; sin ci=on el archivo no estorba porque el
    # script sale temprano.
    _cc "docs/.agents"
    if [ -d "$RUTA_PROYECTO/.github/workflows" ] || [ -d "$RUTA_PROYECTO/.github" ]; then
        _cp "$SRC/.github/workflows/agentes-ci.yml" "$RUTA_PROYECTO/.github/workflows/agentes-ci.yml"
    else
        skip ".github/workflows/agentes-ci.yml — copia la plantilla si activas ci=on"
    fi

    echo ""
    echo -e "  ${NEGRITA}Generando agent-config.md:${RESET}"
    echo ""

    local MODO_FLAG=""
    [ "$MODO_CONFIG" = "actualizar" ]    && MODO_FLAG="MODO: Solo llena campos vacíos. No sobreescribas lo que ya tiene valor."
    [ "$MODO_CONFIG" = "sobreescribir" ] && MODO_FLAG="MODO: Sobreescribe el archivo completo con la información detectada."

    if tiene_claude; then
        ok "Claude Code detectado — analizando con Haiku..."
        echo ""

        local TMP_OUT
        TMP_OUT="$(mktemp)"

        # Construir prompt que fuerza output puro sin conversación
        claude \
            --model claude-haiku-4-5-20251001 \
            --print \
            --no-session-persistence \
            --system-prompt "Eres un generador de archivos de configuración. NUNCA hagas preguntas. NUNCA pidas permiso. NUNCA escribas explicaciones. Tu respuesta SIEMPRE es ÚNICAMENTE el contenido del archivo solicitado, nada más. Sin bloques de código markdown. Sin backticks. Empieza directamente con la primera línea del archivo." \
            "Analiza el proyecto en $RUTA_PROYECTO.

Lee estos archivos para detectar el stack:
- composer.json (si existe)
- package.json (si existe)
- la estructura de carpetas

$(cat "$RUTA_AGENTS/agente-inicializador.md")

$MODO_FLAG

El agent-config.md actual es:
$(cat "$RUTA_AGENTS/agent-config.md" 2>/dev/null || echo '(vacío)')

Genera el agent-config.md completo y actualizado. Empieza con: # agent-config.md" > "$TMP_OUT" 2>/dev/null &

        local PID=$!
        spinner $PID "Analizando proyecto..."
        wait $PID
        local EXIT_CODE=$?

        if [ $EXIT_CODE -eq 0 ] && [ -s "$TMP_OUT" ]; then
            # Verificar que Claude devolvió un archivo válido, no una conversación
            if head -5 "$TMP_OUT" | grep -q "^# agent-config"; then
                # Limpiar bloques de código markdown si los incluyó
                sed 's/^```.*$//' "$TMP_OUT" | sed '/^```$/d' > "$RUTA_AGENTS/agent-config.md"
                rm -f "$TMP_OUT"
                ok "agent-config.md generado"
            else
                rm -f "$TMP_OUT"
                warn "Claude respondió pero no generó un archivo válido."
                info "Completa docs/.agents/agent-config.md manualmente"
                info "o usa el agente inicializador: lee docs/.agents/agente-inicializador.md"
            fi
        else
            rm -f "$TMP_OUT"
            warn "No se pudo generar automáticamente."
            info "Completa docs/.agents/agent-config.md manualmente"
            info "o usa el agente inicializador: lee docs/.agents/agente-inicializador.md"
        fi
    else
        warn "Claude Code no detectado."
        echo ""
        separador
        echo -e "  ${NEGRITA}Pega esto en tu herramienta (Copilot, Cursor, etc.):${RESET}"
        separador
        echo ""
        echo "Lee docs/.agents/agente-inicializador.md y ejecuta las instrucciones."
        echo "Proyecto en: $RUTA_PROYECTO"
        [ -n "$MODO_FLAG" ] && echo "$MODO_FLAG"
        echo ""
        separador
    fi

    # Registrar con qué versión se generó la instancia, para que 'agente doctor'
    # y el actualizador puedan comparar después.
    if [ -f "$RUTA_AGENTS/agent-config.md" ] && [ "$VERSION" != "desconocida" ]; then
        if grep -q "^framework_version=" "$RUTA_AGENTS/agent-config.md"; then
            local TMP_CFG
            TMP_CFG="$(mktemp)"
            sed "s|^framework_version=.*|framework_version=$VERSION|" \
                "$RUTA_AGENTS/agent-config.md" > "$TMP_CFG" && mv "$TMP_CFG" "$RUTA_AGENTS/agent-config.md"
        else
            printf '\n---\n\n## 🏷 Versión del framework\n\n```\nframework_version=%s\n```\n' \
                "$VERSION" >> "$RUTA_AGENTS/agent-config.md"
        fi
    fi

    echo ""
    separador
    echo -e "  ${VERDE}${NEGRITA}✅ Framework inicializado${RESET}  ${GRIS}v$VERSION${RESET}"
    separador
    echo ""
    info "Revisa docs/.agents/agent-config.md"
    info "Ejecuta: agente start"
    echo ""
}

# ─── Actualizar ───────────────────────────────────────────────────────────────
# Dos capas distintas, dos comandos distintos:
#
#   agente actualizar            → el framework GLOBAL (~/.ag-suite-agente-framework)
#                                  se refresca desde GitHub. Requiere red.
#   agente actualizar proyecto   → aplica el framework global YA instalado a este
#                                  proyecto. No toca la red.
#
# Separarlas evita el problema de mezclarlas: antes, correr el actualizador desde
# un directorio cualquiera podía instalar el framework donde no debía, y no había
# forma de aplicar la misma versión a varios proyectos sin volver a descargar.

REPO_URL_FRAMEWORK="https://github.com/angelgarcia-s/ag-suite-agente-framework"
RAMA_FRAMEWORK="main"

cmd_actualizar() {
    local TMP_DIR SRC VERSION_ANTERIOR VERSION_NUEVA

    echo ""
    separador
    echo -e "  ${NEGRITA}Actualizar el framework global${RESET}"
    separador
    echo ""
    info "Destino: $RUTA_FRAMEWORK"
    info "Este comando NO toca ningún proyecto."
    echo ""

    VERSION_ANTERIOR="$(_leer_version_framework)"
    TMP_DIR="$(mktemp -d)"

    info "Descargando la última versión..."
    if command -v curl &>/dev/null; then
        curl -fsSL "$REPO_URL_FRAMEWORK/archive/$RAMA_FRAMEWORK.zip" -o "$TMP_DIR/f.zip" || {
            error "No se pudo descargar. ¿Hay conexión?"; rm -rf "$TMP_DIR"; exit 1; }
    elif command -v wget &>/dev/null; then
        wget -q "$REPO_URL_FRAMEWORK/archive/$RAMA_FRAMEWORK.zip" -O "$TMP_DIR/f.zip" || {
            error "No se pudo descargar. ¿Hay conexión?"; rm -rf "$TMP_DIR"; exit 1; }
    else
        error "Se necesita curl o wget."; rm -rf "$TMP_DIR"; exit 1
    fi

    unzip -q "$TMP_DIR/f.zip" -d "$TMP_DIR"
    SRC="$(find "$TMP_DIR" -maxdepth 1 -type d -name "*-$RAMA_FRAMEWORK" | head -1)"

    if [ -z "$SRC" ] || [ ! -d "$SRC/template" ]; then
        error "El paquete descargado no trae el template."
        rm -rf "$TMP_DIR"; exit 1
    fi
    ok "Descargado"

    # El template completo se reemplaza: todo lo del usuario vive en su proyecto,
    # no aquí. Esta carpeta es solo la fuente de la que 'init' y 'actualizar
    # proyecto' copian.
    rm -rf "$RUTA_FRAMEWORK/template"
    cp -r "$SRC/template" "$RUTA_FRAMEWORK/"
    [ -f "$SRC/VERSION" ] && cp "$SRC/VERSION" "$RUTA_FRAMEWORK/VERSION"

    # El CLI se está ejecutando desde este mismo archivo: se reemplaza con mv
    # (renombre atómico) y no con cp, que truncaría el archivo que bash sigue
    # leyendo y podría dejar la ejecución a medias.
    cp "$SRC/bin/agente" "$RUTA_FRAMEWORK/bin/agente.nuevo"
    chmod +x "$RUTA_FRAMEWORK/bin/agente.nuevo"
    mv "$RUTA_FRAMEWORK/bin/agente.nuevo" "$RUTA_FRAMEWORK/bin/agente"

    chmod +x "$RUTA_FRAMEWORK/template/scripts/"*.sh 2>/dev/null
    rm -rf "$TMP_DIR"

    VERSION_NUEVA="$(_leer_version_framework)"
    ok "Framework global actualizado"
    echo ""
    if [ "$VERSION_ANTERIOR" = "$VERSION_NUEVA" ]; then
        info "Versión: $VERSION_NUEVA (sin cambios)"
    else
        echo -e "  ${NEGRITA}Versión: $VERSION_ANTERIOR → ${VERDE}$VERSION_NUEVA${RESET}"
    fi
    echo ""
    separador
    echo ""
    if [ -f "$RUTA_AGENTS/agent-config.md" ]; then
        info "Para aplicarlo a este proyecto:  ${VERDE}agente actualizar proyecto${RESET}"
    else
        info "Para aplicarlo a un proyecto, entra en él y corre:"
        info "  ${VERDE}agente actualizar proyecto${RESET}"
    fi
    echo ""
}

# Aplica el framework global (ya instalado) a este proyecto. Sin red.
cmd_actualizar_proyecto() {
    local SRC="$RUTA_FRAMEWORK/template"
    local CFG="$RUTA_AGENTS/agent-config.md"

    echo ""
    separador
    echo -e "  ${NEGRITA}$(nombre_proyecto) — Actualizar la instancia${RESET}"
    separador
    echo ""

    if [ ! -f "$CFG" ]; then
        error "Aquí no hay un proyecto con el framework."
        info "Estás en: $RUTA_PROYECTO"
        info "Inicializa con 'agente init' o entra a la raíz del proyecto."
        echo ""; exit 1
    fi
    if [ ! -d "$SRC" ]; then
        error "No se encontró el template del framework en $RUTA_FRAMEWORK"
        info "Corre primero: agente actualizar"
        echo ""; exit 1
    fi

    info "Proyecto:  $RUTA_PROYECTO"
    info "Framework: $RUTA_FRAMEWORK ($(_leer_version_framework))"
    echo ""
    echo -e "  ${NEGRITA}NO se sobrescribe (es tuyo):${RESET}"
    echo -e "    ${GRIS}docs/.agents/agent-config.md${RESET}"
    echo -e "    ${GRIS}docs/.agents/status.md${RESET}"
    echo -e "    ${GRIS}docs/.agents/prompts/proyecto/*.md${RESET}"
    echo -e "    ${GRIS}CLAUDE.md, AGENTS.md y Makefile${RESET}  ${GRIS}(solo se crean si faltan)${RESET}"
    echo ""

    local ADR_ACTIVA
    ADR_ACTIVA="$(leer_status adr)"
    if [ -n "$ADR_ACTIVA" ]; then
        warn "Hay una ADR en curso: $ADR_ACTIVA"
        echo -e "  ${GRIS}Los prompts y el flujo se reemplazan con trabajo a medias.${RESET}"
        echo -e "  ${GRIS}Lo ideal es actualizar entre ADRs, con el pipeline limpio.${RESET}"
        echo ""
    fi

    _confirmar "  ¿Continuar? (s/N): " || { echo "  Cancelado."; echo ""; exit 0; }
    echo ""

    # ── Prompts del núcleo (solo los .md de primer nivel) ──
    mkdir -p "$RUTA_AGENTS/prompts"
    local p
    for p in "$SRC"/docs/.agents/prompts/*.md; do
        [ -f "$p" ] && cp "$p" "$RUTA_AGENTS/prompts/"
    done
    ok "Prompts del núcleo actualizados"

    # ── Carpeta de agentes de proyecto: el README sí, los prompts del usuario no ──
    mkdir -p "$RUTA_AGENTS/prompts/proyecto"
    cp "$SRC/docs/.agents/prompts/proyecto/README.md" "$RUTA_AGENTS/prompts/proyecto/" 2>/dev/null
    skip "prompts/proyecto/*.md — tus agentes de proyecto, preservados"

    # ── Reglas y guías ──
    local d
    for d in agentes.md arranque-terminal.md arranque-sesion.md agente-inicializador.md; do
        cp "$SRC/docs/.agents/$d" "$RUTA_AGENTS/" 2>/dev/null
    done
    ok "Reglas y guías actualizadas"

    # ── Scripts ──
    if [ -d "$RUTA_SCRIPTS" ]; then
        local s
        for s in iniciar-agente.sh lanzar-agentes-iterm.applescript lanzar-agentes-terminal.sh ci-checks.sh; do
            [ -f "$SRC/scripts/$s" ] && cp "$SRC/scripts/$s" "$RUTA_SCRIPTS/$s"
        done
        chmod +x "$RUTA_SCRIPTS/iniciar-agente.sh" "$RUTA_SCRIPTS/lanzar-agentes-terminal.sh" \
                 "$RUTA_SCRIPTS/ci-checks.sh" 2>/dev/null
        ok "Scripts actualizados"
    fi

    # ── Punteros y Makefile: solo si faltan (pueden estar personalizados) ──
    local f
    for f in CLAUDE.md AGENTS.md Makefile; do
        if [ -f "$RUTA_PROYECTO/$f" ]; then
            skip "$f — ya existe, se respeta"
        elif [ -f "$SRC/$f" ]; then
            cp "$SRC/$f" "$RUTA_PROYECTO/$f"; ok "$f instalado"
        fi
    done

    # ── Workflow de CI: solo se refresca si el proyecto ya lo tiene ──
    if [ -f "$RUTA_PROYECTO/.github/workflows/agentes-ci.yml" ]; then
        cp "$SRC/.github/workflows/agentes-ci.yml" "$RUTA_PROYECTO/.github/workflows/agentes-ci.yml"
        ok "Workflow de CI actualizado"
    fi

    # ── Registrar la versión aplicada (única línea que se escribe en la config) ──
    local V TMP_CFG
    V="$(_leer_version_framework)"
    if [ "$V" != "desconocida" ]; then
        if grep -q "^framework_version=" "$CFG"; then
            TMP_CFG="$(mktemp)"
            sed "s|^framework_version=.*|framework_version=$V|" "$CFG" > "$TMP_CFG" && mv "$TMP_CFG" "$CFG"
        else
            printf '\n---\n\n## 🏷 Versión del framework\n\n```\nframework_version=%s\n```\n' "$V" >> "$CFG"
        fi
        ok "Versión registrada: $V"
    fi

    echo ""
    separador
    echo ""
    info "Revisa lo que falta con: ${VERDE}agente doctor${RESET}"
    [ -n "$ADR_ACTIVA" ] && info "Y actualiza el esquema con: ${VERDE}agente migrar-status${RESET}"
    echo ""
}

# ─── Migrar status.md ─────────────────────────────────────────────────────────
# El updater preserva status.md porque es el estado vivo del pipeline, pero el
# esquema del núcleo evoluciona. Esto reconstruye el archivo con la estructura
# nueva CONSERVANDO los valores actuales, para poder actualizar sin esperar a
# cerrar la ADR en curso.
cmd_migrar_status() {
    local TEMPLATE="$RUTA_FRAMEWORK/template/docs/.agents/status.md"
    local ACTUAL="$RUTA_AGENTS/status.md"

    echo ""
    separador
    echo -e "  ${NEGRITA}$(nombre_proyecto) — Migrar status.md${RESET}"
    separador
    echo ""

    if [ ! -f "$ACTUAL" ]; then
        error "No hay status.md en este proyecto."
        echo ""; exit 1
    fi
    if [ ! -f "$TEMPLATE" ]; then
        error "No se encontró el status.md del framework."
        echo ""; exit 1
    fi

    # ── Diferencias de esquema ──
    local NUEVAS HUERFANAS
    NUEVAS="$(comm -13 \
        <(grep -oE '^[a-z_]+=' "$ACTUAL"   | tr -d '=' | sort -u) \
        <(grep -oE '^[a-z_]+=' "$TEMPLATE" | tr -d '=' | sort -u))"
    HUERFANAS="$(comm -23 \
        <(grep -oE '^[a-z_]+=' "$ACTUAL"   | tr -d '=' | sort -u) \
        <(grep -oE '^[a-z_]+=' "$TEMPLATE" | tr -d '=' | sort -u))"

    if [ -z "$NUEVAS" ] && [ -z "$HUERFANAS" ]; then
        ok "Tu status.md ya está en el esquema actual. Nada que migrar."
        echo ""; separador; echo ""
        return 0
    fi

    local ADR_ACTIVO
    ADR_ACTIVO="$(leer_status adr)"
    if [ -n "$ADR_ACTIVO" ]; then
        warn "Hay una ADR activa: $ADR_ACTIVO"
        info "Los valores actuales se conservan, pero si hay agentes trabajando"
        info "en paralelo, ciérralos antes de migrar para que nadie escriba a la vez."
        echo ""
    fi

    if [ -n "$NUEVAS" ]; then
        echo -e "  ${NEGRITA}Campos que se agregarán${RESET} ${GRIS}(con su valor por defecto)${RESET}"
        echo ""
        local n
        for n in $NUEVAS; do
            echo -e "    ${VERDE}+${RESET} $n"
        done
        echo ""
    fi

    if [ -n "$HUERFANAS" ]; then
        echo -e "  ${NEGRITA}Campos que ya no usa el núcleo${RESET} ${GRIS}(se eliminan)${RESET}"
        echo ""
        local h v
        for h in $HUERFANAS; do
            v="$(grep "^$h=" "$ACTUAL" | head -1 | cut -d= -f2-)"
            if [ -n "$v" ]; then
                echo -e "    ${ROJO}-${RESET} $h ${AMARILLO}= $v${RESET}  ${GRIS}← tiene valor${RESET}"
            else
                echo -e "    ${ROJO}-${RESET} $h ${GRIS}(vacío)${RESET}"
            fi
        done
        echo ""
    fi

    echo -e "  ${GRIS}Se guardará un respaldo en status.md.bak${RESET}"
    echo ""
    _confirmar "  ¿Migrar? (s/N): " || { echo "  Cancelado."; echo ""; return 0; }
    echo ""

    cp "$ACTUAL" "$ACTUAL.bak"

    # Reconstruir desde la plantilla, conservando los valores que ya existen.
    # Si una clave no existe en la instancia, se queda el valor por defecto de
    # la plantilla (por eso no se puede simplemente vaciar todo).
    local NUEVO CLAVE
    NUEVO="$(mktemp)"
    while IFS= read -r linea; do
        if echo "$linea" | grep -qE '^[a-z_]+='; then
            CLAVE="$(echo "$linea" | cut -d= -f1)"
            if grep -q "^$CLAVE=" "$ACTUAL"; then
                grep "^$CLAVE=" "$ACTUAL" | head -1
            else
                echo "$linea"
            fi
        else
            echo "$linea"
        fi
    done < "$TEMPLATE" > "$NUEVO"

    # Conservar la bitácora: son eventos históricos, append-only por definición.
    local BITACORA
    BITACORA="$(grep -E '^\[' "$ACTUAL" || true)"
    if [ -n "$BITACORA" ]; then
        echo "$BITACORA" >> "$NUEVO"
    fi

    mv "$NUEVO" "$ACTUAL"

    ok "status.md migrado al esquema actual"
    [ -n "$BITACORA" ] && ok "Bitácora conservada ($(echo "$BITACORA" | wc -l | xargs) entradas)"
    ok "Respaldo en docs/.agents/status.md.bak"
    echo ""
    info "Revisa el archivo antes de seguir con la ADR."
    echo ""
    separador
    echo ""
}

# ─── Doctor ───────────────────────────────────────────────────────────────────
# La instancia preserva su agent-config.md, así que nunca ve las claves que el
# núcleo agrega con el tiempo. Doctor las reporta SIN tocar los valores del
# usuario: compara contra el template versionado y lista lo que falta.
cmd_doctor() {
    local TEMPLATE="$RUTA_FRAMEWORK/template/docs/.agents/agent-config.TEMPLATE.md"
    local CONFIG="$RUTA_AGENTS/agent-config.md"

    echo ""
    separador
    echo -e "  ${NEGRITA}$(nombre_proyecto) — Doctor${RESET}"
    separador
    echo ""

    if [ ! -f "$CONFIG" ]; then
        error "No hay agent-config.md en este proyecto."
        info "Inicializa con: agente init"
        echo ""
        exit 1
    fi

    # ── Versiones ──
    local V_FRAMEWORK V_INSTANCIA
    V_FRAMEWORK="$(_leer_version_framework)"
    V_INSTANCIA="$(leer_config framework_version)"
    V_INSTANCIA="${V_INSTANCIA:-no registrada}"

    echo -e "  ${NEGRITA}Versión${RESET}"
    echo ""
    printf "  %-22s %s\n" "Framework instalado:" "$V_FRAMEWORK"
    printf "  %-22s %s\n" "Instancia generada con:" "$V_INSTANCIA"
    if [ "$V_INSTANCIA" != "$V_FRAMEWORK" ]; then
        echo ""
        warn "La instancia no está en la versión del framework."
        info "Corre 'actualizar.sh' para traer lo nuevo."
    fi
    echo ""

    # ── Claves de config nuevas ──
    if [ ! -f "$TEMPLATE" ]; then
        warn "No se encontró el template de config en el framework."
        echo ""
        exit 0
    fi

    # Claves GLOBALES del template. Se excluye la sección "Agentes de proyecto"
    # (sus claves son de cada bloque [agente], no del proyecto) y los ejemplos
    # comentados, para no reportar como faltante algo que no es una clave global.
    local FALTANTES=()
    local clave
    while IFS= read -r clave; do
        grep -q "^$clave=" "$CONFIG" || FALTANTES+=("$clave")
    done < <(awk '
        /^## .*Agentes de proyecto/ { en_seccion = 1; next }
        /^## / { en_seccion = 0 }
        /<!--/ { en_comentario = 1 }
        /-->/  { en_comentario = 0; next }
        en_seccion || en_comentario { next }
        /^[a-z_]+=/ { sub(/=.*/, ""); print }
    ' "$TEMPLATE" | sort -u)

    linea_fina
    echo ""
    echo -e "  ${NEGRITA}Claves de configuración${RESET}"
    echo ""
    if [ ${#FALTANTES[@]} -eq 0 ]; then
        ok "Tu agent-config.md tiene todas las claves del template."
    else
        warn "Hay ${#FALTANTES[@]} clave(s) disponibles que tu config no declara:"
        echo ""
        for clave in "${FALTANTES[@]}"; do
            echo -e "    ${AMARILLO}$clave${RESET}"
        done
        echo ""
        info "Son opcionales: nada se rompe sin ellas."
        info "Si quieres usarlas, agrégalas a mano — el updater NO toca tu config."
        info "Referencia: $TEMPLATE"
    fi
    echo ""

    # ── Archivos core que faltan ──
    linea_fina
    echo ""
    echo -e "  ${NEGRITA}Archivos del núcleo${RESET}"
    echo ""
    local ARCHIVO CORE_FALTANTES=0
    for ARCHIVO in \
        "docs/.agents/agentes.md" \
        "docs/.agents/status.md" \
        "docs/.agents/prompts/orchestrator.md" \
        "docs/.agents/prompts/backend.md" \
        "docs/.agents/prompts/frontend.md" \
        "docs/.agents/prompts/qa.md" \
        "docs/.agents/prompts/context.md" \
        "docs/.agents/prompts/featuredocs.md" \
        "docs/.agents/prompts/api-architect.md" \
        "docs/.agents/prompts/api-contract-reviewer.md" \
        "docs/.agents/prompts/proyecto/README.md" \
        "scripts/iniciar-agente.sh" \
        "scripts/ci-checks.sh" \
        "CLAUDE.md" \
        "AGENTS.md"
    do
        if [ ! -e "$RUTA_PROYECTO/$ARCHIVO" ]; then
            echo -e "    ${AMARILLO}falta${RESET}  $ARCHIVO"
            CORE_FALTANTES=$((CORE_FALTANTES + 1))
        fi
    done
    if [ "$CORE_FALTANTES" -eq 0 ]; then
        ok "Todos los archivos del núcleo están presentes."
    else
        echo ""
        info "Corre 'actualizar.sh' para traerlos."
    fi

    # ── Esquema de status.md ──
    # El updater lo preserva (es estado vivo), así que no recibe los campos que
    # el núcleo agrega. Sin este aviso, el desfase se descubre a media ADR.
    local TPL_STATUS="$RUTA_FRAMEWORK/template/docs/.agents/status.md"
    if [ -f "$TPL_STATUS" ] && [ -f "$RUTA_AGENTS/status.md" ]; then
        local ST_NUEVAS ST_HUERFANAS
        ST_NUEVAS="$(comm -13 \
            <(grep -oE '^[a-z_]+=' "$RUTA_AGENTS/status.md" | tr -d '=' | sort -u) \
            <(grep -oE '^[a-z_]+=' "$TPL_STATUS"            | tr -d '=' | sort -u))"
        ST_HUERFANAS="$(comm -23 \
            <(grep -oE '^[a-z_]+=' "$RUTA_AGENTS/status.md" | tr -d '=' | sort -u) \
            <(grep -oE '^[a-z_]+=' "$TPL_STATUS"            | tr -d '=' | sort -u))"

        echo ""
        linea_fina
        echo ""
        echo -e "  ${NEGRITA}Esquema de status.md${RESET}"
        echo ""
        if [ -z "$ST_NUEVAS" ] && [ -z "$ST_HUERFANAS" ]; then
            ok "Al día con el esquema del núcleo."
        else
            [ -n "$ST_NUEVAS" ] && {
                warn "Faltan $(echo "$ST_NUEVAS" | wc -l | xargs) campo(s) del esquema nuevo:"
                echo "$ST_NUEVAS" | tr '\n' ' ' | sed 's/^/      /'; echo ""
            }
            [ -n "$ST_HUERFANAS" ] && {
                echo -e "  ${GRIS}Campos que el núcleo ya no usa: $(echo "$ST_HUERFANAS" | tr '\n' ' ')${RESET}"
            }
            echo ""
            info "Corre 'agente migrar-status' — conserva tus valores y respalda el archivo."
        fi
    fi

    # ── Makefile vs roles activos ──
    # El Makefile del proyecto se preserva (puede estar personalizado), así que
    # nunca gana los targets de roles nuevos.
    if [ -f "$RUTA_PROYECTO/Makefile" ]; then
        local ROL SIN_TARGET=""
        for ROL in orquestador backend frontend qa contexto documentador; do
            grep -q "^$ROL:" "$RUTA_PROYECTO/Makefile" || SIN_TARGET="$SIN_TARGET $ROL"
        done
        if [ -n "$SIN_TARGET" ]; then
            echo ""
            linea_fina
            echo ""
            echo -e "  ${NEGRITA}Makefile${RESET}"
            echo ""
            warn "Tu Makefile no tiene target para:$SIN_TARGET"
            info "Se preserva a propósito por si lo personalizaste."
            info "Usa 'agente run <rol>' o copia el target desde:"
            info "$RUTA_FRAMEWORK/template/Makefile"
        fi
    fi

    # ── CLAUDE.md puntero ──
    if [ -f "$RUTA_PROYECTO/CLAUDE.md" ]; then
        local LINEAS
        LINEAS=$(wc -l < "$RUTA_PROYECTO/CLAUDE.md" | tr -d ' ')
        if [ "$LINEAS" -gt 80 ]; then
            echo ""
            warn "CLAUDE.md tiene $LINEAS líneas — debería ser un puntero delgado."
            info "Si tiene stack o reglas inline, muévelas a agent-config.md."
        fi
    fi

    echo ""
    separador
    echo ""
}

# ─── Help ─────────────────────────────────────────────────────────────────────
cmd_help() {
    echo ""
    separador
    echo -e "  ${NEGRITA}${AZUL}AG Suite Agent Framework${RESET}  ${GRIS}v$VERSION${RESET}"
    separador
    echo ""
    echo -e "  ${NEGRITA}Uso:${RESET} agente [comando]"
    echo ""
    echo -e "  ${NEGRITA}Principal${RESET}"
    echo -e "  ${VERDE}start${RESET}               Launcher interactivo — punto de entrada"
    echo -e "  ${VERDE}start iterm${RESET}          Abre todos los agentes en iTerm2 (paneles)"
    echo -e "  ${VERDE}start terminal${RESET}       Abre todos los agentes en Terminal.app (ventanas)"
    echo -e "  ${VERDE}start sesion${RESET}         Modo sesión única — un agente cambia de rol"
    echo ""
    echo -e "  ${NEGRITA}Pipeline${RESET}"
    echo -e "  ${VERDE}init${RESET}                Inicializa el framework en este proyecto"
    echo -e "  ${VERDE}doctor${RESET}              Compara tu instancia con el framework y reporta lo que falta"
    echo -e "  ${VERDE}migrar-status${RESET}       Actualiza el esquema de status.md conservando tus valores"
    echo ""
    echo -e "  ${NEGRITA}Actualización${RESET}  ${GRIS}(dos capas distintas)${RESET}"
    echo -e "  ${VERDE}actualizar${RESET}            Framework global desde GitHub ${GRIS}(no toca proyectos)${RESET}"
    echo -e "  ${VERDE}actualizar proyecto${RESET}   Aplica el framework global a este proyecto ${GRIS}(sin red)${RESET}"
    echo -e "  ${VERDE}dashboard${RESET}           Monitoreo del pipeline con notificaciones (solo observa)"
    echo -e "  ${VERDE}status${RESET}              Estado rápido del pipeline"
    echo -e "  ${VERDE}reset${RESET}               Limpia status.md después de merge"
    echo ""
    echo -e "  ${NEGRITA}Agentes${RESET}"
    echo -e "  ${VERDE}run${RESET} [rol]           Inicia un agente en esta terminal"
    echo ""
    echo -e "  ${NEGRITA}Roles:${RESET} orquestador · backend · frontend · qa · contexto · documentador"
    echo ""
    echo -e "  ${NEGRITA}Ejemplos${RESET}"
    echo -e "  ${GRIS}agente${RESET}                Abre el launcher interactivo"
    echo -e "  ${GRIS}agente start iterm${RESET}    Abre 6 paneles en iTerm2"
    echo -e "  ${GRIS}agente start terminal${RESET} Abre 5 ventanas en Terminal.app"
    echo -e "  ${GRIS}agente start sesion${RESET}   Inicia modo sesión única (Copilot/Claude)"
    echo -e "  ${GRIS}agente dashboard${RESET}      Dashboard en terminal dedicada"
    echo -e "  ${GRIS}agente run backend${RESET}    Inicia solo el agente Backend"
    echo -e "  ${GRIS}agente reset${RESET}          Limpia pipeline después de merge"
    echo ""
    separador
    echo ""
}

# ─── Reset ────────────────────────────────────────────────────────────────────
cmd_reset() {
    local ADR="$(leer_status adr)"
    local NOMBRE="$(nombre_proyecto)"

    echo ""
    separador
    echo -e "  ${NEGRITA}$NOMBRE — Reset del pipeline${RESET}"
    separador
    echo ""

    if [ -n "$ADR" ]; then
        echo -e "  ADR actual: ${AZUL}$ADR${RESET} — $(leer_status titulo)"
        echo ""
        warn "Esto limpiará status.md completamente."
        echo -e "  ${GRIS}Úsalo solo después de merge o para empezar limpio.${RESET}"
        echo ""
        _confirmar "  ¿Continuar? (s/N): " || { echo "  Cancelado."; echo ""; exit 0; }
    fi

    # El reset es la única reescritura completa permitida de status.md: solo
    # ocurre tras el merge, cuando ningún agente está trabajando.
    # Debe reflejar el mismo esquema que template/docs/.agents/status.md.
    cat > "$RUTA_AGENTS/status.md" << 'RESET_STATUS'
# Pipeline Status
# Canal de comunicación entre agentes.
# Formato: clave=valor — NO usar markdown ni bloques de código al escribir.
# Protocolo de escritura (ownership, testigo, append-only): docs/.agents/agentes.md

# ─── ADR Activo ──────────────────────────────────────────────────────────────
# Dueño: Orquestador
adr=
titulo=
branch=
api_contract=
iniciado=

# ─── Estado del Orquestador ──────────────────────────────────────────────────
# idle | coordinating | reviewing | awaiting_human | pr_ready
orchestrator=idle
orchestrator_ts=

# ─── Estado por agente ───────────────────────────────────────────────────────
# idle | ready | in_progress | done | needs_fix | blocked
# 'ready' y 'needs_fix' los escribe el Orquestador; el resto, el propio agente.
backend=idle
backend_ts=
backend_mensaje=

frontend=idle
frontend_ts=
frontend_mensaje=

qa=idle
qa_ts=
qa_mensaje=
qa_alcance=

contexto=idle
contexto_ts=
contexto_mensaje=

featuredocs=idle
featuredocs_ts=
featuredocs_mensaje=

# ─── Issues ──────────────────────────────────────────────────────────────────
backend_issues=
frontend_issues=
completados=

# ─── Handoff ─────────────────────────────────────────────────────────────────
# Dueño: Orquestador — ningún agente escribe aquí.
handoff_phase=
handoff_message=

# ─── Blocker ─────────────────────────────────────────────────────────────────
# Dueño: Orquestador — un agente bloqueado usa su propio _mensaje.
blocker_agente=
blocker_detalle=

# ─── Aprobación humana ───────────────────────────────────────────────────────
aprobacion=pending
aprobado_por=
nota=

# ─── Bitácora (APPEND-ONLY) ──────────────────────────────────────────────────
# Formato: [YYYY-MM-DD HH:MM] agente: qué pasó
RESET_STATUS

    echo ""
    ok "Pipeline limpio. Listo para el siguiente ADR."
    echo ""
    separador
    echo ""
}

# ─── Sesión única ─────────────────────────────────────────────────────────────
cmd_sesion() {
    local NOMBRE="$(nombre_proyecto)"

    echo ""
    separador
    echo -e "  ${NEGRITA}$NOMBRE — Modo Sesión Única${RESET}"
    separador
    echo ""
    info "Un solo agente cambia de rol autónomamente."
    info "Funciona con Claude Code, Copilot, Cursor o cualquier LLM."
    echo ""

    if tiene_claude; then
        ok "Claude Code detectado — abriendo sesión multiagente..."
        echo ""

        local PROMPT_ORCH
        PROMPT_ORCH="$(cat "$RUTA_AGENTS/prompts/orchestrator.md" 2>/dev/null || echo "")"

        claude \
            --append-system-prompt "Eres un sistema multiagente autónomo para $NOMBRE.

$PROMPT_ORCH

MODO SESIÓN ÚNICA:
- Ejecuta el pipeline completo cambiando de rol según status.md
- Anuncia cada cambio de rol explícitamente
- Actualiza status.md al terminar cada fase
- Respeta los gates de aprobación humana" \
            --name "$NOMBRE | Multiagente"
    else
        warn "Claude Code no detectado."
        echo ""
        separador
        echo -e "  ${NEGRITA}Pega esto en tu herramienta (Copilot, Cursor, etc.):${RESET}"
        separador
        echo ""
        if [ -f "$RUTA_AGENTS/arranque-sesion.md" ]; then
            cat "$RUTA_AGENTS/arranque-sesion.md"
        else
            echo "Eres un sistema multiagente autónomo para $NOMBRE."
            echo "Lee docs/.agents/agent-config.md, docs/.agents/agentes.md y docs/.agents/status.md."
            echo "Ejecuta el pipeline cambiando de rol según el estado."
        fi
        echo ""
        separador
    fi

    echo ""
}

# ─── Router ───────────────────────────────────────────────────────────────────
case "${1:-start}" in
    start)
        case "${2:-}" in
            iterm)    _launcher_start_iterm ;;
            terminal) _launcher_start_terminal ;;
            sesion)   cmd_sesion ;;
            *)        cmd_start ;;
        esac
        ;;
    iterm)          _launcher_start_iterm ;;
    terminal)       _launcher_start_terminal ;;
    sesion)         cmd_sesion ;;
    init)           cmd_init ;;
    doctor)         cmd_doctor ;;
    migrar-status)  cmd_migrar_status ;;
    actualizar)
        case "${2:-}" in
            proyecto|instancia) cmd_actualizar_proyecto ;;
            "")                 cmd_actualizar ;;
            *) error "Uso: agente actualizar [proyecto]"; exit 1 ;;
        esac
        ;;
    dashboard)      cmd_dashboard ;;
    status)         cmd_status ;;
    reset)          cmd_reset ;;
    run)            bash "$RUTA_SCRIPTS/iniciar-agente.sh" "$2" ;;
    help|--help|-h) cmd_help ;;
    version|-v)     echo "AG Suite Agent Framework v$VERSION" ;;
    *)  error "Comando desconocido: $1"; echo ""; cmd_help; exit 1 ;;
esac
